# LLM Configuration (DeepSeek for Head Gardener & Researcher)
DEEPSEEK_API_KEY=sk-...

# Optional: Anthropic (if needed for other purposes)
ANTHROPIC_API_KEY=sk-ant-...

# Vercel AI Gateway (for embeddings)
AI_GATEWAY_API_KEY=vck_...
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1/ai

# Graph Database (Memgraph)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=

# Web Research (Firecrawl)
FIRECRAWL_API_KEY=fc-...

# Storage (LibSQL)
LIBSQL_URL=file:/data/memory.db

# Audit Log
AUDIT_LOG_PATH=/data/audit.jsonl

# Application
NODE_ENV=development
PORT=3000
