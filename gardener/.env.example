# Memgraph
MEMGRAPH_URI=bolt://your-memgraph-vm:7687
MEMGRAPH_USER=geargraphadmin
MEMGRAPH_PASSWORD=your-password

# LLM Provider
OPENAI_API_KEY=sk-...
# Or for Gemini:
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Firecrawl
FIRECRAWL_API_KEY=fc-...

# Web Search
TAVILY_API_KEY=tvly-...

# Deployment target
DEPLOY_TARGET=cloudrun  # or "vercel" in Phase 2/3
